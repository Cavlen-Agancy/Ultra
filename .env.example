# =============================================================================
# Ultra — environment variables
# Copy to `.env` on the server (that file is the only server-side secret
# store; it is git-ignored and docker-ignored, never baked into the image).
#
# Legend:
#   [REQUIRED-PROD]  production breaks/boots-unsafe without it
#   [OPTIONAL]       feature disabled gracefully when empty
#   RUNTIME          read by the running server; overrides work live
#   BUILD-TIME       read during `nuxt build` / image build (see note below)
#
# BUILD-TIME BAKING NOTE:
# The image is built WITHOUT .env (docker-ignored). nuxt.config.ts sets only
# empty-string placeholders in runtimeConfig, so nothing is baked. At runtime
# Nitro maps every NUXT_* / NUXT_PUBLIC_* env var onto runtimeConfig:
#   runtimeConfig.sessionPassword        -> NUXT_SESSION_PASSWORD
#   runtimeConfig.public.firebaseApiKey  -> NUXT_PUBLIC_FIREBASE_API_KEY
#   ... etc.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────

# [REQUIRED-PROD] [RUNTIME: Prisma Client + one-shot migrate service]
# Local dev (app runs on the host): localhost:5434, as shown below.
# Production (app runs inside compose): use db:5432 and the real password.
# Example production value:
#   postgresql://ultra:CHANGE_ME_DB_PASSWORD@db:5432/ultra_db?schema=public
DATABASE_URL="postgresql://ultra:ultra@localhost:5434/ultra_db?schema=public"

# [REQUIRED-PROD] [RUNTIME: postgres container env, read by the db service]
# Referenced by docker-compose.prod.yml with :?required — empty means the
# stack refuses to start. Local dev (docker-compose.yml) uses "ultra".
POSTGRES_PASSWORD="CHANGE_ME_DB_PASSWORD"

# ─── Security secrets ───────────────────────────────────────────────────────

# [REQUIRED-PROD] [RUNTIME via NUXT_* override] Session sealing password
# (runtimeConfig.sessionPassword; server-only). Min 32 characters.
# Generate: openssl rand -base64 32
NUXT_SESSION_PASSWORD="CHANGE_ME_MIN_32_CHARS_RANDOM_STRING_HERE"

# [REQUIRED-PROD] [RUNTIME: server/utils/encryption.ts via process.env]
# AES-256-GCM key for encrypted settings (e.g. payment credentials).
# Exactly 64 hex chars (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARS________________________________"

# ─── Firebase Cloud Messaging (server side, never commit real values) ──────

# [OPTIONAL] [RUNTIME: server/utils/fcm.ts via process.env]
# Missing/invalid values = push notifications disabled gracefully (log warn).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Literal "\n" escapes in the JSON private key are restored automatically.
FIREBASE_PRIVATE_KEY=

# ─── Firebase web config (PUBLIC keys only, exposed to the browser) ─────────

# [OPTIONAL] [RUNTIME via NUXT_* override -> runtimeConfig.public]
# Any empty value means push notifications stay off.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_VAPID_KEY=

# ─── Payment market placeholders (optional) ─────────────────────────────────

# [OPTIONAL] Used only when online payments are enabled. These are neutral
# placeholders; set the gateway-supported ISO currency and country later.
PAYMENT_CURRENCY="XXX"
PAYMENT_COUNTRY="XX"
PAYMENT_COUNTRY_CODE="0"

# ─── Public site URL ────────────────────────────────────────────────────────

# [OPTIONAL / recommended] [RUNTIME via NUXT_* override]
# Canonical origin, no trailing slash. Use the real production domain later.
# Empty means the app falls back to the request origin at runtime (never baked).
NUXT_PUBLIC_SITE_URL=

# ─── Initial super-admin seed (manual one-time runs only) ──────────────────

# [OPTIONAL] [RUNTIME(process): read ONLY by `node prisma/seed.mjs`]
# The seed requires SEED_ADMIN_PASSWORD and creates no demo catalog.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_ADMIN_SEED_PASSWORD"

# ─── Server runtime (set by docker-compose.prod.yml; override if needed) ───

# [OPTIONAL] [RUNTIME: Nitro bind address/port]
NITRO_HOST="0.0.0.0"
NITRO_PORT="3000"
